---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import {
  gradient, avatarClass, writingLabel, writingTagClass,
  statusLabel, statusTagClass,
} from '../lib/format';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order,
);

const posts = (await getCollection('writing'))
  .filter((p) => import.meta.env.PROD ? !p.data.draft : true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---
<BaseLayout title="Yun-Jie Christina Wu — cognitive & computational neuroscience" active="about">

  <!-- ABOUT ME -->
  <section class="about" id="about">
    <div class="photo">
      <span class="tag">about</span>
      <img src="/profile.png" alt="Yun-Jie Christina Wu" />
    </div>
    <div class="info">
      <h1 class="name">Yun-Jie Christina Wu</h1>
      <p class="role">Researcher, <b>cognitive &amp; computational neuroscience</b> · Taipei, Taiwan</p>
      <a class="cta" href="/research/">Read the research →</a>
      <div class="bio">
        <p>I study how the brain recognizes and comprehends — from unconscious recognition to
          multimodal models of speech. My work moves between behavioral experiments, fMRI, and
          machine learning.</p>
        <p>Right now I'm training a multimodal (auditory · visual · fMRI) model for speech
          comprehension, and building a speech-to-brain-activity encoder.</p>
      </div>
      <div class="tags">
        <span>#cognitive-neuroscience</span><span>#fMRI</span>
        <span>#speech-comprehension</span><span>#machine-learning</span>
      </div>
      <div class="social">
        <a href="mailto:you@example.com" title="Email" aria-label="Email"><svg viewBox="0 0 24 24"><path d="M2 4h20v16H2V4zm10 7L4 6v.01L12 11l8-5V6l-8 5z"/></svg></a>
        <a href="https://github.com/" title="GitHub" aria-label="GitHub"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg></a>
        <a href="https://scholar.google.com/" title="Google Scholar" aria-label="Google Scholar"><svg viewBox="0 0 24 24"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v3.5L12 20l7-3.32v-3.5L12 16l-7-2.82z"/></svg></a>
        <a href="https://x.com/" title="X" aria-label="X"><svg viewBox="0 0 24 24"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.8l-5.3-6.9L4.8 22H1.7l8-9.2L1 2h6.9l4.8 6.3L18.9 2zm-2.4 18h1.9L7.6 4H5.6l10.9 16z"/></svg></a>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="sec" id="projects">
    <div class="sec-head">
      <span class="label">Projects</span><h2>Research</h2>
      <a class="more" href="/research/">All research →</a>
    </div>
    <div class="gallery">
      {research.map((r) => (
        <GalleryCard
          href="/research/"
          title={r.data.title}
          oneliner={r.data.summary}
          tagLabel={statusLabel(r.data.status)}
          tagClass={statusTagClass(r.data.status)}
          gradient={gradient(r.data.color)}
          avatar={avatarClass(r.data.color)}
        />
      ))}
    </div>
  </section>

  <!-- WRITING -->
  <section class="sec" id="writing">
    <div class="sec-head">
      <span class="label">Writing</span><h2>Notes &amp; essays</h2>
      {posts.length > 0 && <a class="more" href="/writing/">All writing →</a>}
    </div>
    {posts.length > 0 ? (
      <div class="gallery">
        {posts.map((p) => (
          <GalleryCard
            href={`/writing/${p.id}/`}
            title={p.data.title}
            oneliner={p.data.summary}
            tagLabel={writingLabel(p.data.type)}
            tagClass={writingTagClass(p.data.type)}
            gradient={gradient(p.data.color)}
            avatar={avatarClass(p.data.color)}
          />
        ))}
      </div>
    ) : (
      <div class="coming">
        <h3><span class="dot-badge"></span>Coming soon</h3>
        <p>First essays are on the way — reflective notes, science observations, and opinions.</p>
      </div>
    )}
  </section>

</BaseLayout>
