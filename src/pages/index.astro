---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import {
  gradient, avatarClass, writingLabel, writingTagClass,
  statusLabel, statusTagClass,
} from '../lib/format';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order,
);

const posts = (await getCollection('writing'))
  .filter((p) => import.meta.env.PROD ? !p.data.draft : true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---
<BaseLayout title="Yun-Jie Christina Wu — cognitive & computational neuroscience" active="about">

  <!-- ABOUT ME -->
  <section class="about" id="about">
    <div class="photo">
      <span class="tag">about</span>
      <img class="photo-frame is-active" src="/profile.png" alt="Yun-Jie Christina Wu" />
      <img class="photo-frame" src="/profile-2.png" alt="Yun-Jie Christina Wu, illustrated" />
    </div>
    <div class="info">
      <h1 class="name">Yun-Jie Christina Wu</h1>
      <p class="role">Research Assistant, <b>cognitive &amp; computational neuroscience</b> · Academia Sinica, Taipei, Taiwan</p>
      <a class="cta" href="/research/">Read the research →</a>
      <div class="bio">
        <p>I study how the brain recognizes and comprehends — from unconscious recognition to
          multimodal models of speech. My work moves between behavioral experiments, fMRI, and
          machine learning.</p>
        <p>Right now I'm investigating how the brain organizes cross-modal speech representations
          and prioritizes goal-relevant features through audiovisual fMRI studies. My future goal
          is to apply "brain-tuning" techniques within a Ph.D. program to align multimodal models
          with neural data, bridging computational neuroscience and machine learning to realize my
          vision of developing assistive technologies that adapt to a user's unique neural and
          perceptual representations.</p>
        <p>In my free time, I like hiking and playing badminton. I'm also into sports more
          broadly — I've played basketball, volleyball, track (though not field), and aerial
          yoga.</p>
      </div>
      <div class="tags">
        <span>#cognitive-neuroscience</span><span>#fMRI</span>
        <span>#speech-comprehension</span><span>#machine-learning</span>
      </div>
      <div class="social">
        <a href="mailto:yunjie.christina@gmail.com" title="Email" aria-label="Email"><svg viewBox="0 0 24 24"><path d="M2 4h20v16H2V4zm10 7L4 6v.01L12 11l8-5V6l-8 5z"/></svg></a>
        <a href="https://github.com/yunjiewuw" title="GitHub" aria-label="GitHub"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg></a>
        <a href="https://medium.com/@christina_yunjiewu" title="Medium" aria-label="Medium"><svg viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg></a>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="sec" id="projects">
    <div class="sec-head">
      <span class="label">Projects</span><h2>Research</h2>
      <a class="more" href="/research/">All research →</a>
    </div>
    <div class="gallery">
      {research.map((r) => (
        <GalleryCard
          href={`/research/${r.id}/`}
          title={r.data.title}
          oneliner={r.data.summary}
          tagLabel={statusLabel(r.data.status)}
          tagClass={statusTagClass(r.data.status)}
          gradient={gradient(r.data.color)}
          avatar={avatarClass(r.data.color)}
          image={r.data.image}
        />
      ))}
    </div>
  </section>

  <!-- WRITING -->
  <section class="sec" id="writing">
    <div class="sec-head">
      <span class="label">Writing</span><h2>Notes &amp; essays</h2>
      {posts.length > 0 && <a class="more" href="/writing/">All writing →</a>}
    </div>
    {posts.length > 0 ? (
      <div class="gallery">
        {posts.map((p) => (
          <GalleryCard
            href={`/writing/${p.id}/`}
            title={p.data.title}
            oneliner={p.data.summary}
            tagLabel={writingLabel(p.data.type)}
            tagClass={writingTagClass(p.data.type)}
            gradient={gradient(p.data.color)}
            avatar={avatarClass(p.data.color)}
            image={p.data.image}
          />
        ))}
      </div>
    ) : (
      <div class="coming">
        <h3><span class="dot-badge"></span>Coming soon</h3>
        <p>First essays are on the way — reflective notes, science observations, and opinions.</p>
      </div>
    )}
  </section>

</BaseLayout>

<style>
  /* Crossfade rotation between multiple .photo-frame images (see script below). */
  .photo-frame{transition:opacity 900ms ease}
  .photo-frame:not(.is-active){opacity:0}
</style>

<script>
  // Rotates through every .photo-frame image in .photo every 20s, crossfading.
  // Add another <img class="photo-frame"> to include a 3rd photo in the rotation.
  const frames = document.querySelectorAll<HTMLImageElement>('.photo-frame');
  if (frames.length > 1) {
    let i = 0;
    setInterval(() => {
      frames[i].classList.remove('is-active');
      i = (i + 1) % frames.length;
      frames[i].classList.add('is-active');
    }, 20000);
  }
</script>
